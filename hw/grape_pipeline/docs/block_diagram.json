          "sub": "GrapeDriver.advance()"
        },
        {
          "id": "axi",
          "label": "AXI4-Lite handshake",
          "sub": "axi_lite_if + decoder, 4 KB"
        }
      ]
    },
    {
      "name": "Control",
      "blocks": [
        {
          "id": "regs",
          "label": "Register file",
          "sub": "pending/latched cfg, STATUS, IRQ"
        },
        {
          "id": "fsm",
          "label": "Step FSM",
          "sub": "doorbell, abort, NSTEPS loop"
        },
        {
          "id": "cnt",
          "label": "Counters",
          "sub": "CYCLES 64b, STEPS_DONE 32b"
        }
      ]
    },
    {
      "name": "State",
      "blocks": [
        {
          "id": "body",
          "label": "Body register file",
          "sub": "working + committed, 5 \u00d7 7 FP64"
        },
        {
          "id": "pairs",
          "label": "Pair list",
          "sub": "\u226410 \u00d7 (i, j)"
        }
      ]
    },
    {
      "name": "Datapath (FP64)",
      "blocks": [
        {
          "id": "pipe",
          "label": "Pair pipeline",
          "sub": "sub \u2192 r\u00b2 \u2192 sqrt \u2192 rcp \u2192 \u00d7dt \u2192 \u00d7m"
        },
        {
          "id": "acc",
          "label": "Velocity accumulate",
          "sub": "6 FMA, ordered by pair"
        },
        {
          "id": "integ",
          "label": "Position integrator",
          "sub": "r += dt\u00b7v, 5 bodies"
        }
      ]
    }
  ],
  "edges": [
