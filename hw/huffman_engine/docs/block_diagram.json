{
  "title": "huffman_engine \u2014 architecture (MAS)",
  "columns": [
    {
      "name": "Host / DMA",
      "blocks": [
        {
          "id": "cpu",
          "label": "CPU + driver",
          "sub": "HuffmanDriver.decode_block()"
        },
        {
          "id": "axi",
          "label": "AXI4-Lite handshake",
          "sub": "axi_lite_if + decoder, 4 KB"
        },
        {
          "id": "dma",
          "label": "Platform DMA",
          "sub": "s_bits / s_sel in, m_sym out"
        }
      ]
    },
    {
