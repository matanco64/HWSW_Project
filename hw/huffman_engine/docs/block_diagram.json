        },
        {
          "id": "fsm",
          "label": "Block FSM",
          "sub": "doorbell \u2192 build \u2192 decode \u2192 EOB"
        },
        {
          "id": "cnt",
          "label": "Counters",
          "sub": "CYCLES, SYMBOLS, BITS, BUILD, OVERFETCH"
        }
      ]
    },
    {
      "name": "Tables",
      "blocks": [
        {
          "id": "lenwin",
          "label": "Length window",
          "sub": "6 \u00d7 288 \u00d7 5 bit, pending/latched"
        },
        {
          "id": "builder",
          "label": "Table builder",
          "sub": "count \u2192 first_code \u2192 base \u2192 symtab"
        },
        {
          "id": "tabs",
          "label": "6 table register sets",
          "sub": "first_code/count/base per length"
        },
        {
          "id": "symtab",
          "label": "Symbol table RAM",
          "sub": "6 \u00d7 288 \u00d7 9 bit"
        }
      ]
    },
    {
      "name": "Aligner",
      "blocks": [
        {
          "id": "fifo",
          "label": "Word FIFO",
          "sub": "s_bits 32-bit, TKEEP, TLAST"
        },
        {
          "id": "win",
          "label": "Bit window",
          "sub": "64-bit, peek 20, consume \u2264 20, zero pad"
        },
        {
          "id": "rev",
          "label": "Mode reversal",
          "sub": "MSB-first bzip2 / LSB-first DEFLATE"
        }
      ]
    },
    {
      "name": "Decoder",
      "blocks": [
        {
          "id": "cascade",
          "label": "Comparator cascade",
          "sub": "20 lengths in parallel"
        },
        {
          "id": "prio",
          "label": "Priority encode",
          "sub": "shortest match, length"
        },
        {
          "id": "lookup",
          "label": "Symbol lookup",
          "sub": "base + code \u2212 first_code"
        },
        {
          "id": "extra",
          "label": "Extra bits (DEFLATE)",
          "sub": "length/distance bases"
        }
      ]
    },
    {
      "name": "Output",
      "blocks": [
        {
          "id": "sel",
          "label": "Selector FSM",
          "sub": "s_sel, switch every 50 symbols"
        },
        {
          "id": "pack",
          "label": "Beat packer",
          "sub": "ADR-0006 32-bit beats, TLAST on EOB"
        }
      ]
    }
  ],
