# Produces /home/yuvalk/HWSW/HWSW_Proj/hw/mtf_cam/synth/area.txt with a technology-independent `stat` followed by the
# sky130_fd_sc_hd Liberty-mapped `stat -liberty` (cell counts + chip area in um^2).
read_verilog -sv /home/yuvalk/HWSW/HWSW_Proj/hw/mtf_cam/rtl/item_fifo.sv /home/yuvalk/HWSW/HWSW_Proj/hw/mtf_cam/rtl/mtf_cam.sv /home/yuvalk/HWSW/HWSW_Proj/hw/mtf_cam/rtl/mtf_ctrl.sv /home/yuvalk/HWSW/HWSW_Proj/hw/mtf_cam/rtl/mtf_expand.sv /home/yuvalk/HWSW/HWSW_Proj/hw/mtf_cam/rtl/mtf_list.sv /home/yuvalk/HWSW/HWSW_Proj/hw/mtf_cam/rtl/mtf_pack.sv /home/yuvalk/HWSW/HWSW_Proj/hw/mtf_cam/rtl/mtf_regs.sv /home/yuvalk/HWSW/HWSW_Proj/hw/mtf_cam/rtl/mtf_run.sv /home/yuvalk/HWSW/HWSW_Proj/hw/common/rtl/axi_lite_if.sv
hierarchy -check -top mtf_cam
