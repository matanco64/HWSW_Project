# formal scratch is handled precisely by the root .gitignore now (model/, engine_0/,
# src/, logfile.txt, status*, *.xml). This file used to ignore the whole formal_*/ and
# formal/ trees, which swallowed the PASS files too -- that is why this module ships no
# formal evidence while grape and huffman do.
sim_build_cov/
# PPA (stage 9) local artifacts: OpenLane run tree is covered by root hw/**/runs/;
# the write_json netlist dump (~10 MB) and yosys logs are regenerable, not tracked.
synth/*_synth.json
synth/*.log
# dv_signoff formal scratch (root dirs, not under synth/)
scratch_*/
scratch_*.sby
