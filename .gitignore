__pycache__/
*.pyc
# perf raw data is large; committed evidence is the derived reports/SVGs/JSONs
results/*.perf.data
results/*.perf.data.old
# Where the runner scripts write. A single `./script_<bench>.sh profile` leaves
# ~165 MB here, and a grader's run should not show up as untracked changes to
# the submission. Promoting a run to authoritative stays a deliberate copy.
results/runs/
# build artifacts
rust/**/target/
venv/
.venv/
# hardware flow: local toolchain, venv, simulation & synthesis artifacts
hw/tools/
hw/.venv/
hw/**/sim_build*/
hw/**/obj_dir/
hw/**/*.gch
hw/**/*_synth.json
hw/**/results.xml
hw/**/*.vcd
hw/**/*.fst
hw/**/*.fst.hier
hw/**/runs/
hw/**/__pycache__/
hw/**/.pytest_cache/
hw/**/coverage.dat
hw/.advisor/
hw/**/coverage_annotated/
hw/**/sim_build_icarus/
hw/common/synth/area.txt

# local-only notes (Technion infra detail) and identity data - never commit.
# report/ids.local holds the ID numbers and report/ids.pdf is the page built
# from them; this repository is public and git history would keep them for good.
*.local.md
*.local.txt
report/ids.local
report/ids.pdf
tmp/*

# Private working notes and self-assessment, not part of the submission
output/
.claude/worktrees/

# make_submission.sh output; the archive is rebuilt from any commit on demand
submission/
hw/**/synth/signoff_*.log

# SymbiYosys scratch. A proof's evidence is its PASS file and the config.sby that
# produced it; everything else under formal*/ is regenerated by the next run and was
# 164 tracked files (~2 MB) until 2026-09-25. mtf_cam ignored its whole formal_*/
# tree, which is why that module ships no PASS at all -- keep these three lines in
# step so the same thing cannot happen again.
hw/**/synth/formal*/model/
hw/**/synth/formal*/engine_0/
hw/**/synth/formal*/src/
hw/**/synth/formal*/logfile.txt
hw/**/synth/formal*/status
hw/**/synth/formal*/status.path
hw/**/synth/formal*/status.sqlite
hw/**/synth/formal*/*.xml

# Yosys transcripts: 17 MB across three modules, regenerated by `make area`.
hw/**/synth/yosys*.log

# macOS
.DS_Store
